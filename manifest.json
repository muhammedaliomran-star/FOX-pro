{
  "manifest_version": 3,
  "name": "FOX pro",
  "version": "1.0.0",
  "description": "FOX Pro — Unlimited AI builds. Professional license manager.",
  "icons": {
    "16": "icons/icon-ar-16.png",
    "32": "icons/icon-ar-32.png",
    "48": "icons/icon-ar-48.png",
    "128": "icons/icon-ar-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-ar-16.png",
      "32": "icons/icon-ar-32.png",
      "48": "icons/icon-ar-48.png",
      "128": "icons/icon-ar-128.png"
    },
    "default_title": "Lovable Pro"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://io.eklas.dev/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/*", "styles/*", "icons/*"],
      "matches": ["https://lovable.dev/*"]
    }
  ]
}
